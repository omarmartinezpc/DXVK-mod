 namespace dxvk {
+
+  /**
+   * \brief Checks whether display mode switches should be skipped
+   *
+   * Enabled with "dxgi.noModeSwitch = True" in dxvk.conf. When set, the
+   * monitor keeps its current resolution when an application enters
+   * fullscreen or requests a new target mode. The game still creates
+   * its back buffer at the requested (lower) resolution and DXVK scales
+   * it up to the window when presenting.
+   */
+  static bool SkipDisplayModeSwitch() {
+    static const bool skip = []() {
+      Config config = Config::getUserConfig();
+      config.merge(Config::getAppConfig(env::getExePath()));
+
+      const bool value = config.getOption<bool>("dxgi.noModeSwitch", false);
+
+      if (value)
+        Logger::info("DXGI: dxgi.noModeSwitch enabled, display mode changes are skipped");
+
+      return value;
+    }();
+
+    return skip;
+  }
+
   
